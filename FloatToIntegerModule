class FunctionNodeFloatToIntModule : public Module {
public:
  override auto GetFetchInfo() : FetchInfo {
    return {
      constants: {"rounding_mode0"},
      input_ports: {"Float0"},
      output_ports: {"Integer0"},
    };
  }

  override auto GenerateTokenString() : AbstractToken[] {
    string mode = GetConstant("rounding_mode0");
    string func_expr;

    if (mode == "ROUND") {
      // In GLSL führt round() zu float, daher ist ein int()-Cast notwendig
      func_expr = "int(round(";
    } else if (mode == "FLOOR") {
      func_expr = "int(floor(";
    } else if (mode == "CEILING" || mode == "CEIL") {
      func_expr = "int(ceil(";
    } else if (mode == "TRUNCATE" || mode == "TRUNC") {
      // Direct casting in GLSL cuts off fraction (truncates towards zero)
      func_expr = "int(";
    } else {
      // Fallback
      func_expr = "int(";
    }

    return {
      WildcardToken("Integer0"),
      TextToken(" = "),
      TextToken(func_expr),
      WildcardToken("Float0"),
      TextToken(");")
    };
  }
};